# Required. Each must be 32+ characters, differ from the other, and not look like
# a placeholder -- the app refuses to start otherwise. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
DATABASE_URL=sqlite:///audinexia.db
FLASK_ENV=development
# Werkzeug's debugger/reloader. OFF unless set to 1: the debugger's console
# executes arbitrary Python for anyone who can reach it.
FLASK_DEBUG=0
# Cross-origin access is closed by default (the dashboard and API share one
# origin). Only set this if a separate frontend origin must call the API.
# CORS_ORIGINS=https://app.example.com

# --- Browser sessions ---------------------------------------------------------
# Auth cookies are Secure (HTTPS-only) by default. Browsers treat localhost as a
# secure context, so local http dev works in Chrome/Edge/Firefox; set 0 only if
# your browser refuses to store them over plain http (e.g. Safari). Never set 0
# behind real HTTPS.
# COOKIE_SECURE=1

# --- Password reset email -----------------------------------------------------
# Without MAIL_HOST no email is sent: the reset link is written to the server log
# at WARNING instead (so an operator can still recover an account). Set these to
# send real mail through your SMTP provider.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
# MAIL_USE_TLS=1        # STARTTLS; use MAIL_USE_SSL=1 + port 465 for implicit TLS
# Absolute origin used in emailed links (set this in production):
# APP_BASE_URL=https://grc.example.com
# PASSWORD_RESET_MINUTES=30

# --- Breached-password check --------------------------------------------------
# Passwords are checked against Have I Been Pwned's k-anonymity API (only a 5-char
# hash prefix is sent). Fails open if unreachable. Set 0 for air-gapped installs.
# HIBP_CHECK_ENABLED=1
