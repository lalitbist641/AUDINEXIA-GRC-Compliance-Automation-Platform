# Required. Must be 32+ characters and not contain "change-me" -- the app
# refuses to boot otherwise (see config.py). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_SECRET_KEY=change-me-to-a-different-random-64-char-string
DATABASE_URL=sqlite:///audinexia.db
# Werkzeug's debugger/reloader. Leave off (0) outside local development --
# the debugger's console can execute arbitrary Python for anyone who can
# reach it.
FLASK_DEBUG=0
# Auth cookies are marked Secure (HTTPS-only) by default. Browsers treat
# http://localhost and http://127.0.0.1 as secure contexts, so this works for
# local dev in Chrome/Edge/Firefox; set 0 only if your browser refuses to store
# the cookie over plain http (e.g. Safari). Never set 0 behind real HTTPS.
COOKIE_SECURE=1
